# Shopify Partner app credentials (Partners Dashboard > Apps > your app > Client credentials)
SHOPIFY_API_KEY=your_api_key_here
SHOPIFY_API_SECRET=your_api_secret_here

# Comma separated Admin API access scopes this app needs
SCOPES=read_products,write_script_tags

# Publicly reachable URL for this server (ngrok/cloudflared URL in dev, real domain in prod)
# No trailing slash.
HOST=https://your-tunnel-url.example.com

# Random long string used to sign the session cookie
SESSION_SECRET=change_this_to_a_long_random_string

PORT=3000
